node_modules/
dist/
build/
coverage/
.env
*.log
npm-debug.log*
.DS_Store
Thumbs.db
CloudPort-Final.zip
application/frontend/tsconfig.tsbuildinfo

# ---------------------------------------------------------------------------
# Terraform — NEVER commit state, provider caches, or real tfvars
# ---------------------------------------------------------------------------
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
.terraform.lock.hcl
# Allow example files but block real credential-containing tfvars
*.tfvars
!*.tfvars.example
terraform.rc
.terraformrc
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------------------------------------------------------------------------
# Cloud credentials — NEVER commit
# ---------------------------------------------------------------------------
# GCP service account key files
gcp-sa-key.json
*-sa-key.json
service-account*.json
application_default_credentials.json
# AWS credential files (local overrides)
.aws/credentials
# Generated kubeconfig files from cloud clusters
kubeconfig-aws-*.yaml
kubeconfig-gcp-*.yaml
kubeconfig-eks-*.yaml
kubeconfig-gke-*.yaml

# ---------------------------------------------------------------------------
# Locust load test results (generated data, not source)
# ---------------------------------------------------------------------------
platform/multicloud/locust/results/
*.locust_stats.csv
*.locust_failures.csv
locust_*.csv

# ---------------------------------------------------------------------------
# Evidence artifacts generated by experiments
# ---------------------------------------------------------------------------
docs/reports/


# Python bytecode cache
__pycache__/
*.pyc
