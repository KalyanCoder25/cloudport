{
  "name": "cloudport",
  "version": "1.0.0",
  "private": true,
  "description": "Infrastructure-Aware Application Portability, Controlled A/B Experimentation, Telemetry, Leakage Analysis, Evidence, and Recovery Platform.",
  "workspaces": [
    "application/backend",
    "application/frontend"
  ],
  "scripts": {
    "db:migrate": "node --env-file=.env application/database/migrate.js up",
    "db:migrate:down": "node --env-file=.env application/database/migrate.js down",
    "db:seed": "node --env-file=.env application/database/seed.js",
    "db:status": "node --env-file=.env application/database/migrate.js status",
    "test": "node --env-file=.env --test tests/**/*.test.js",
    "test:unit": "node --env-file=.env --test tests/unit/*.test.js",
    "test:api": "node --env-file=.env --test tests/api/*.test.js",
    "test:safety": "node --env-file=.env --test tests/safety/*.test.js",
    "lint": "eslint application/backend/src analyzer platform --ext .js",
    "build": "npm run build --workspace application/frontend",
    "dev:backend": "node --env-file=.env application/backend/src/server.js",
    "dev:frontend": "npm run dev --workspace application/frontend"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "js-yaml": "^4.3.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  }
}
