# ---------------------------------------------------------------------------
# CloudPort environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=cloudport
PGUSER=cloudport
PGPASSWORD=changeme
DATABASE_URL=postgres://cloudport:changeme@localhost:5432/cloudport

# --- Backend API ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Observability (OpenTelemetry / Prometheus / Grafana) ---
# Port the backend's OTel Prometheus exporter binds to (see
# application/backend/src/telemetry/otel.js). Scraped by the `prometheus`
# service in docker-compose.yml; set CLOUDPORT_DISABLE_OTEL=1 to skip
# instrumentation entirely (useful when running many backend instances
# locally, since only one can bind this port at a time).
OTEL_METRICS_PORT=9464
CLOUDPORT_DISABLE_OTEL=

# --- Statistics service (SciPy-backed paired t-test) ---
# analyzer/telemetry/scipyStatsClient.js calls this when set and falls back
# to the pure-JS implementation in statisticalTests.js when it is not set or
# unreachable. Runs via `docker compose up statistics` (services/statistics/).
STATS_SERVICE_URL=http://localhost:8090

# --- Application identity (must never change workload behavior) ---
APP_VERSION=cloudport:1.0.0
INFRA_IDENTITY=unset

# --- Storage workload mount ---
# Directory the deterministic STORAGE workload performs its read/write
# operations against. In Kubernetes this MUST be set to the path where the
# infrastructure's PVC is mounted (both Infrastructure A and Infrastructure B
# mount their PVC at /data -- see platform/infrastructure-a/02-deployment.yaml
# and platform/infrastructure-b/03-deployment.yaml). If unset, the workload
# engine falls back to an OS temp directory, which is fine for local
# development but INVALID for an actual storage-isolation experiment.
CLOUDPORT_STORAGE_MOUNT=/data

# --- Kubernetes / Kind / Korifi ---
EXPECTED_KUBE_CONTEXT=kind-korifi
KUBECONFIG=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000/api

# ===========================================================================
# MULTI-CLOUD CAPSTONE CONFIGURATION
# These variables are ONLY used for the AWS EKS vs GCP GKE experiments.
# They are NOT used by the existing kind-korifi experiments.
# NEVER put real credentials in this file. Use environment variables or
# the standard AWS/GCP authentication mechanisms described in:
#   docs/multicloud/security.md
# ===========================================================================

# --- AWS Configuration ---
# Authentication: set AWS_PROFILE to use an AWS CLI profile, OR set
# AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY as environment variables
# (never in this file). Preferred: AWS IAM Identity Center (SSO) via profile.
AWS_PROFILE=default
AWS_REGION=ap-south-1

# --- GCP Configuration ---
# Authentication: use Application Default Credentials (gcloud auth application-default login)
# or point GOOGLE_APPLICATION_CREDENTIALS at a service account key file
# (never commit the key file; add to .gitignore).
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1

# --- Multi-Cloud Kubernetes Contexts ---
# These context names are set by infra/contexts/configure-contexts.sh
# after Terraform provisions the clusters. They MUST match the names
# in your kubeconfig. The existing kind-korifi context is never changed.
MULTICLOUD_CONTEXT_AWS=aws-eks-cloudport
MULTICLOUD_CONTEXT_GCP=gcp-gke-cloudport

# --- Multi-Cloud Benchmark ---
BENCHMARK_APP=online-boutique
BENCHMARK_NAMESPACE=online-boutique
BENCHMARK_VERSION=v0.10.1

# --- Locust Load Generation ---
LOCUST_USERS=50
LOCUST_SPAWN_RATE=5
LOCUST_DURATION_SECONDS=300
LOCUST_HOST=http://frontend.online-boutique.svc.cluster.local:80

