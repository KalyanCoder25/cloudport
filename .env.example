# ---------------------------------------------------------------------------
# CloudPort environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=cloudport
PGUSER=cloudport
PGPASSWORD=changeme
DATABASE_URL=postgres://cloudport:changeme@localhost:5432/cloudport

# --- Backend API ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Application identity (must never change workload behavior) ---
APP_VERSION=cloudport:1.0.0
INFRA_IDENTITY=unset

# --- Storage workload mount ---
# Directory the deterministic STORAGE workload performs its read/write
# operations against. In Kubernetes this MUST be set to the path where the
# infrastructure's PVC is mounted (both Infrastructure A and Infrastructure B
# mount their PVC at /data -- see platform/infrastructure-a/02-deployment.yaml
# and platform/infrastructure-b/03-deployment.yaml). If unset, the workload
# engine falls back to an OS temp directory, which is fine for local
# development but INVALID for an actual storage-isolation experiment.
CLOUDPORT_STORAGE_MOUNT=/data

# --- Kubernetes / Kind / Korifi ---
EXPECTED_KUBE_CONTEXT=kind-korifi
KUBECONFIG=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000/api
