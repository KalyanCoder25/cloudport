{
  "title": "CloudPort Overview",
  "uid": "cloudport-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Scrape target health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [{ "expr": "up", "legendFormat": "{{job}}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Experiments by status",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "cloudport_experiments_total", "legendFormat": "{{status}}" }]
    },
    {
      "id": 3,
      "title": "Deployments by provider / status",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "cloudport_deployments_total", "legendFormat": "{{provider}} / {{status}}" }]
    },
    {
      "id": 4,
      "title": "Leakage score by experiment (kind-korifi)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "cloudport_leakage_score_latest", "legendFormat": "{{experiment_id}}" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 100 } }
    },
    {
      "id": 5,
      "title": "Leakage score by experiment (multi-cloud)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "cloudport_multicloud_leakage_score_latest", "legendFormat": "{{experiment_id}}" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 100 } }
    },
    {
      "id": 6,
      "title": "Statistics service — request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum by (endpoint, status) (rate(cloudport_statistics_requests_total[5m]))",
          "legendFormat": "{{endpoint}} ({{status}})"
        }
      ]
    },
    {
      "id": 7,
      "title": "Statistics service — p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(cloudport_statistics_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{endpoint}} p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
